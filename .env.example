# Chiave API Groq per l'assistente vocale, la lettura delle etichette e la
# stima da foto.
#
# ATTENZIONE: le variabili EXPO_PUBLIC_* finiscono nel bundle in chiaro e sono
# estraibili dall'APK. Accettabile finché l'app resta a uso personale e l'APK
# non viene distribuito. Se un giorno l'app va condivisa, questa chiave va
# spostata dietro un proxy server-side.
EXPO_PUBLIC_GROQ_API_KEY=

# Il backend: copia dei dati sul server e parte amici.
#
# Senza questa riga l'app funziona lo stesso e la sezione account si spegne da
# sola: è local-first, il server è un di più. Con `php artisan serve` nel
# backend, l'emulatore Android raggiunge il computer a 10.0.2.2 (da un telefono
# vero serve l'IP della macchina sulla rete locale).
EXPO_PUBLIC_API_URL=https://esempio.tld/api
