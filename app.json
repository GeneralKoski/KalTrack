{
  "expo": {
    "name": "KalTrack",
    "slug": "kaltrack",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaltrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.koski.kaltrack",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.koski.kaltrack",
      "versionCode": 1,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "fade": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins-Light.ttf",
            "./assets/fonts/Poppins-LightItalic.ttf",
            "./assets/fonts/Poppins-Regular.ttf",
            "./assets/fonts/Poppins-Italic.ttf",
            "./assets/fonts/Poppins-Medium.ttf",
            "./assets/fonts/Poppins-MediumItalic.ttf",
            "./assets/fonts/Poppins-SemiBold.ttf",
            "./assets/fonts/Poppins-SemiBoldItalic.ttf",
            "./assets/fonts/Poppins-Bold.ttf",
            "./assets/fonts/Poppins-BoldItalic.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "it"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "KalTrack accede alle foto per allegare l'immagine di un alimento o di un pasto.",
          "cameraPermission": "KalTrack usa la fotocamera per scattare la foto di un alimento o di un pasto."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KalTrack usa la fotocamera per leggere il codice a barre di un prodotto.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "KalTrack usa il microfono per registrare quello che dici e trascriverlo nel diario."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#18181b"
        }
      ],
      "react-native-health-connect",
      "./plugins/withAssistantShortcut",
      "./plugins/withHomeWidget",
      "expo-asset"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
